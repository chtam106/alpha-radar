{
  "name": "crypto",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run typecheck && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:style": "stylelint \"src/**/*.scss\"",
